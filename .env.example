# Neon connection string (Neon console → Connect). Use the pooled one, which has "-pooler" in the host.
# Leave it empty to run in browser-only demo mode.
DATABASE_URL=

# The shared password the organizer signs in with.
ORGANIZER_PASSWORD=

# A long random string that signs the organizer's session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The site's public address, used for the party page QR code (for example https://your-site.vercel.app).
# Leave empty to use whatever address the organizer has open.
VITE_PUBLIC_URL=
